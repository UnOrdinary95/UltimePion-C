execute_process(COMMAND "${PROGRAM}" "${MODE}"
    INPUT_FILE "${INPUT}" OUTPUT_VARIABLE actual ERROR_VARIABLE errors
    RESULT_VARIABLE result TIMEOUT 5)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Program failed (${result}): ${errors}")
endif()
if(DEFINED EXPECTED_MESSAGE)
    if(EXPECTED_MESSAGE STREQUAL "draw")
        set(message "Partie nulle.")
        set(forbidden "Joueur [12] a gagné")
    elseif(EXPECTED_MESSAGE STREQUAL "player1")
        set(message "Joueur 1 a gagné.")
        set(forbidden "Partie nulle|Joueur 2 a gagné")
    else()
        set(message "Joueur 2 a gagné.")
        set(forbidden "Partie nulle|Joueur 1 a gagné")
    endif()
    string(FIND "${actual}" "${message}" found)
    if(found EQUAL -1 OR actual MATCHES "${forbidden}")
        message(FATAL_ERROR "Unexpected winner output:\n${actual}")
    endif()
else()
    file(READ "${EXPECTED}" expected)
    # The specification defines whitespace-separated tokens, not trailing spaces.
    string(REGEX REPLACE "[ \t\r\n]+" " " actual "${actual}")
    string(REGEX REPLACE "[ \t\r\n]+" " " expected "${expected}")
    string(STRIP "${actual}" actual)
    string(STRIP "${expected}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Expected: ${expected}\nActual:   ${actual}\nStderr: ${errors}")
    endif()
endif()
